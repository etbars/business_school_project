    def _parse_response(self, response: str) -> Dict[str, Any]:
        """
        Parse the response from the LLM.
        
        Args:
            response: JSON response from the LLM
            
        Returns:
            Parsed response as a dictionary
        """
        try:
            # Check if the response is a valid JSON string
            if not response or not response.strip():
                logger.error("Empty response received")
                return {}
            
            # Try to extract JSON from the response if it contains markdown or other text
            json_match = re.search(r'```json\s*([\s\S]*?)\s*```', response)
            if json_match:
                json_str = json_match.group(1).strip()
                logger.info("Extracted JSON from markdown code block")
                # Remove comments before parsing
                json_str = self._remove_json_comments(json_str)
                return json.loads(json_str)
            
            # Try to find JSON object in the response
            json_match = re.search(r'({[\s\S]*})', response)
            if json_match:
                json_str = json_match.group(1).strip()
                logger.info("Extracted JSON from response text")
                # Remove comments before parsing
                json_str = self._remove_json_comments(json_str)
                return json.loads(json_str)
            
            # If no JSON pattern found, try to parse the entire response
            # Remove comments before parsing
            response = self._remove_json_comments(response)
            return json.loads(response)
        except json.JSONDecodeError as e:
            logger.error(f"Error parsing JSON response: {str(e)}")
            return {}
    
    def _remove_json_comments(self, json_str: str) -> str:
        """
        Remove comments from JSON string.
        
        Args:
            json_str: JSON string with potential comments
            
        Returns:
            Clean JSON string without comments
        """
        # Remove single-line comments (// comment)
        json_str = re.sub(r'//.*?$', '', json_str, flags=re.MULTILINE)
        
        # Remove multi-line comments (/* comment */)
        json_str = re.sub(r'/\*.*?\*/', '', json_str, flags=re.DOTALL)
        
        logger.info("Removed comments from JSON string")
        return json_str
    
    def _generate_description(self, alert_type: str, parameters: Dict[str, Any]) -> str:
        """
        Generate a human-readable description based on alert type.
        
        Args:
            alert_type: Type of alert
            parameters: Alert parameters
            
        Returns:
            Human-readable description
        """
        alert_type_def = registry.get_type(alert_type)
        if not alert_type_def:
            return f"Unknown alert type: {alert_type}"
            
        # Create instance of the alert type class
        alert_type_instance = alert_type_def.type_class()
        
        try:
            # Use the alert type's description generator
            return alert_type_instance.get_description(parameters)
        except KeyError as e:
            # Handle missing parameters gracefully
            logger.warning(f"Missing parameter in description generation: {str(e)}")
            
            # Fallback description
            return f"{alert_type.capitalize()} alert with parameters: {', '.join([f'{k}={v}' for k, v in parameters.items()])}"
    
    def _normalize_parameters(self, alert_type: str, raw_parameters: Dict[str, Any]) -> Dict[str, Any]:
        """
        Normalize parameters to ensure compatibility with client-side parsers.
        
        Args:
            alert_type: Type of alert
            raw_parameters: Raw parameters from the LLM
            
        Returns:
            Normalized parameters
        """
        # Get the alert type definition
        alert_type_def = registry.get_type(alert_type)
        if not alert_type_def:
            return raw_parameters
        
        # Create normalized parameters
        normalized = {}
        
        # Copy parameters, applying any necessary transformations
        for key, value in raw_parameters.items():
            # Convert keys to camelCase if needed
            normalized_key = key
            
            # Handle specific parameter transformations
            if key == "targetValue":
                normalized_key = "targetValue"  # Ensure consistent casing
            elif key == "target_value":
                normalized_key = "targetValue"
            
            normalized[normalized_key] = value
        
        return normalized

