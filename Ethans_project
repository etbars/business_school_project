async def analyze_alert_request(
    request: Union[str, Dict[str, Any]],
    user_history: Optional[List[Dict[str, Any]]] = None,
    user_preferences: Optional[Dict[str, Any]] = None
) -> Dict[str, Any]:
    """
    Analyze a natural language alert request using context-aware processing
    and generate related alert suggestions.
    
    Args:
        request: Natural language request or pre-parsed request dictionary
        user_history: Optional list of user's previous alerts
        user_preferences: Optional dictionary of user preferences
        
    Returns:
        Analysis result with alert type, parameters, and suggestions
    """
    try:
        # Extract request text if a dictionary was provided
        request_text = request if isinstance(request, str) else request.get("text", "")
        user_id = request.get("user_id", "unknown") if isinstance(request, dict) else "unknown"
        
        # If request_text is empty but request is a string, use the string
        if not request_text and isinstance(request, str):
            request_text = request
            
        if not request_text:
            logger.error("Empty request text")
            return {
                "success": False,
                "message": "Empty request text",
                "alert_type": None,
                "parameters": {},
                "required_apis": [],
                "description": "",
                "suggestions": []
            }
        
        # Process the request
        logger.info(f"Processing request: {request_text}")
        result = await agent_service.process_natural_language_request(user_id, request_text)
        
        # Log the full result for debugging
        logger.info(f"Process result: {json.dumps(result)}")
        
        # Check if the result contains an error
        if "error" in result:
            logger.error(f"Error processing request: {result.get('error', 'Unknown error')}")
            return {
                "success": False,
                "message": result.get("error", "Failed to process request"),
                "alert_type": None,
                "parameters": {},
                "required_apis": [],
                "description": "",
                "suggestions": []
            }
        
        # Format the result for the client
        return {
            "success": True,
            "message": "Alert analyzed successfully",
            "alert_type": result.get("alert_type"),
            "parameters": result.get("parameters", {}),
            "required_apis": result.get("required_apis", []),
            "description": result.get("description", ""),
            "suggestions": result.get("suggestions", [])
        }
    except Exception as e:
        logger.exception(f"Exception in analyze_alert_request: {str(e)}")
        return {
            "success": False,
            "message": f"Error processing request: {str(e)}",
            "alert_type": None,
            "parameters": {},
            "required_apis": [],
            "description": "",
            "suggestions": []
        }
